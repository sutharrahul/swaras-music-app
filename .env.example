# Copy to `.env.local` for local dev. On Vercel, add these same 4 as Project
# Environment Variables instead — nothing else is required to host this app.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle at build
# time. Never put a secret behind that prefix.

# --- Supabase (required) -----------------------------------------------------
# Public: safe in the browser, protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL="https://wwtglvbctakstnguqrzk.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Secret: BYPASSES Row Level Security. Server-side only — never import it into
# a client component, never give it a NEXT_PUBLIC_ prefix.
#
# `src/lib/storage.server.ts` uses it to sign every playback URL, because
# `song-audio` is a private bucket. Leave it empty and the app still builds and
# renders, but every audioUrl comes back null and nothing plays — silently.
SUPABASE_SECRET_KEY=""

# --- App (required) -----------------------------------------------------------
# Used as metadataBase for absolute Open Graph/canonical URLs. Nothing else
# reads this — auth redirects derive from window.location.origin, not this var.
# On Vercel, set it to your real domain for the Production scope only.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Not required to host -----------------------------------------------------
# CRON_SECRET: only matters if you add a `crons` entry to vercel.json calling
# /api/upload-song/sweep-expired. Without it, that cleanup is still reachable
# as a manual "run now" by any signed-in admin — nothing is broken by omitting
# this. See the route's own comment before wiring up the cron.
#
# Database URL / direct URL: not used. supabase-js talks HTTP to PostgREST, so
# the app never opens a Postgres connection and holds no pool to exhaust.
# Migrations run through the Supabase CLI, which authenticates against the
# linked project rather than a connection string.
#
# Auth/Storage config: nothing else to set here. Sign-in, sign-up, Google
# OAuth, and the /auth/callback code exchange all run on the two Supabase
# variables above — provider setup (Google Client ID/Secret, redirect URLs)
# lives in the Supabase and Google dashboards, not in this app's env.
