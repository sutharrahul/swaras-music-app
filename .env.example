# Copy to `.env.local` and fill in. Keeping everything in `.env.local` means
# secrets live in exactly one file.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle. Never put a
# secret behind that prefix.

# --- Supabase ---------------------------------------------------------------
# There is deliberately no DATABASE_URL / DIRECT_URL here any more. supabase-js
# talks HTTP to PostgREST, so the app opens no database connections at all and
# there is no pool for serverless functions to exhaust. Migrations go through the
# Supabase CLI (`npm run db:push`), which authenticates against the linked
# project rather than a DSN.
NEXT_PUBLIC_SUPABASE_URL="https://wwtglvbctakstnguqrzk.supabase.co"
# Publishable key: safe in the browser, protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Secret key: BYPASSES Row Level Security entirely. Server-side only — never
# import it into a client component, and never give it a NEXT_PUBLIC_ prefix.
# Prefer not to need it: user-scoped queries go through the request-bound server
# client so RLS applies. Reach for this only where a request genuinely has no
# user (webhook, cron sweep), from a `server-only` module.
SUPABASE_SECRET_KEY=""

# Supabase Auth is now the only identity provider. There is nothing else to
# configure here: sign-in, sign-up and the `/auth/callback` code exchange all run
# on the two variables above. In the Supabase dashboard, set
# Authentication → URL Configuration → Site URL to NEXT_PUBLIC_SITE_URL and add
# `<site>/auth/callback` to the redirect allow-list, or email confirmation links
# will bounce.

# --- Storage ----------------------------------------------------------------
# Nothing to configure. Media lives in the `song-audio` and `song-covers`
# Supabase Storage buckets, created by supabase/migrations/*_storage.sql, and
# reached with the two variables above: the browser uploads to them directly
# over TUS with the signed-in admin's own access token, and playback URLs are
# signed per request on the server. There is no third-party media host and no
# API secret to hold any more.

# --- App --------------------------------------------------------------------
# Public origin, used as metadataBase so Open Graph and canonical URLs resolve
# to absolute URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
