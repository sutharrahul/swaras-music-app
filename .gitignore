# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# build output
build/
dist/

# prisma generated client
packages/database/generated/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# secrets handed to tooling at runtime — never committed
supabaseToken.md
*.token

# Supabase CLI link state. Local to whoever ran `supabase link`, and
# `pooler-url` carries a connection string — never commit it. The migrations
# under supabase/migrations/ ARE tracked; only this scratch dir is not.
supabase/.temp/
