# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# build output
build/
dist/

# prisma generated client
packages/database/generated/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local agent instructions. Kept on disk so Claude Code reads it, but not
# published — it is working notes, not documentation for other people.
CLAUDE.md

# secrets handed to tooling at runtime — never committed
supabaseToken.md
resend.md
*.token

# Supabase CLI link state. Local to whoever ran `supabase link`, and
# `pooler-url` carries a connection string — never commit it. The migrations
# under supabase/migrations/ ARE tracked; only this scratch dir is not.
supabase/.temp/

# Personal interview-prep notes. Local only — never commit or push.
INTERVIEW_PREP.md

# Local-only working notes. Kept on disk, not published — these predate the
# Supabase migration and describe an architecture that no longer exists.
docs/API_HOOKS_GUIDE.md
docs/QUICK_REFERENCE.md
docs/ARCHITECTURE_DIAGRAM.md
docs/SUPABASE_INTEGRATION_SPEC.md
docs/CHANGELOG.md
docs/project/
docs/v0/
